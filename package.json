{
  "name": "bridge-ifc-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype IFC4.3 bridge viewer for a state DOT bridge office. Static site, no build step.",
  "type": "module",
  "scripts": {
    "vendor": "bash scripts/vendor.sh",
    "csp": "node scripts/update-csp.mjs",
    "test": "node --test tests/*.test.mjs",
    "serve": "python3 -m http.server 8080",
    "demo-ifc": "python3 scripts/make_demo_ifc.py samples/demo-bridge.ifc"
  }
}
